{
  "title": "Tour Guide — Backend Overview",
  "uid": "tour-guide-backend",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (handler) (rate(http_requests_total[1m]))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 2,
      "title": "Error rate by endpoint (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (handler) (rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 3,
      "title": "Request latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{handler}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{handler}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{handler}}" }
      ]
    },
    {
      "id": 4,
      "title": "LLM call latency by call-site",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, call_site) (rate(llm_call_duration_seconds_bucket[5m])))", "legendFormat": "{{call_site}}" }
      ]
    },
    {
      "id": 5,
      "title": "LLM call error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum by (call_site) (rate(llm_call_total{status=\"error\"}[5m]))", "legendFormat": "{{call_site}}" }
      ]
    },
    {
      "id": 6,
      "title": "Active streaming chat sessions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "chat_streaming_sessions_active", "legendFormat": "active sessions" }
      ]
    },
    {
      "id": 7,
      "title": "Streaming session duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_streaming_session_duration_seconds_bucket[5m])))", "legendFormat": "p95 duration" }
      ]
    },
    {
      "id": 8,
      "title": "External API latency & error rate by provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, api) (rate(external_api_call_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{api}}" },
        { "expr": "sum by (api) (rate(external_api_call_errors_total[5m]))", "legendFormat": "errors {{api}}" }
      ]
    },
    {
      "id": 9,
      "title": "Mongo operation latency by collection",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, collection) (rate(mongo_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{collection}}" }
      ]
    },
    {
      "id": 10,
      "title": "Agent tool invocations",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "sum by (tool) (increase(agent_tool_invocations_total[1h]))", "legendFormat": "{{tool}}" }
      ]
    }
  ]
}
